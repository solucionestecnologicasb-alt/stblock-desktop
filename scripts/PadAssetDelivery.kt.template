import java.util.concurrent.atomic.AtomicBoolean

/** Serves install-time PAD files under the same static resource URLs as the web build. */
object PadAssetDelivery {
  private const val PACK_NAME = "models3d_pack"
  private const val DEBUG_FILE = "stblock-mobile-debug.jsonl"
  private const val MAX_DEBUG_BYTES = 4L * 1024L * 1024L
  @Volatile private var manager: AssetPackManager? = null
  @Volatile private var appContext: Context? = null
  private val debugLock = Any()
  private val bootstrapInstalled = AtomicBoolean(false)

  fun initialize(context: Context) {
    appContext = context.applicationContext
    record("native", "initialized package=${context.packageName} sdk=${android.os.Build.VERSION.SDK_INT} model=${android.os.Build.MODEL}")
    try {
      manager = AssetPackManagerFactory.getInstance(context.applicationContext)
      val location = manager?.getPackLocation(PACK_NAME)
      record("pad", "pack=$PACK_NAME status=${location?.packStorageMethod() ?: "not-installed"} assetsPath=${location?.assetsPath() ?: "<null>"}")
    } catch (error: Exception) {
      manager = null
      record("pad", "manager-init-failed ${error.javaClass.simpleName}: ${error.message}")
    }
  }

  fun record(category: String, message: String) {
    // El archivo de diagnóstico sólo se escribe en builds debug: en release no
    // debe consumir almacenamiento ni E/S en los dispositivos de los usuarios.
    if (!BuildConfig.DEBUG) return
    val context = appContext ?: return
    try {
      synchronized(debugLock) {
        val directory = context.getExternalFilesDir("debug") ?: context.filesDir
        if (!directory.exists()) directory.mkdirs()
        val file = File(directory, DEBUG_FILE)
        if (file.length() > MAX_DEBUG_BYTES) {
          val previous = File(directory, "$DEBUG_FILE.1")
          previous.delete()
          file.renameTo(previous)
        }
        val safeMessage = message.replace('\n', ' ').replace('\r', ' ').take(4000)
        file.appendText("${System.currentTimeMillis()}\t$category\t$safeMessage\n")
      }
    } catch (_: Exception) {}
  }

  fun installDiagnostics(webView: WebView) {
    // El safe-area es funcional y corre siempre; las sondas de diagnóstico
    // (DOM, Blockly, iframes) sólo se inyectan en builds debug.
    applySafeArea(webView)
    if (!BuildConfig.DEBUG) return
    bootstrapInstalled.set(false)
    webView.postDelayed({
      applySafeArea(webView)
      if (bootstrapInstalled.compareAndSet(false, true)) {
        webView.evaluateJavascript(DEBUG_BOOTSTRAP, null)
      }
    }, 500)
  }

  /**
   * The Android WebView reports env(safe-area-inset-*) as 0 even in edge-to-edge
   * mode. Publish the real inset (status bar, display cutout and the mandatory
   * gesture strip) as a CSS variable so the Kids toolbar stays tappable.
   */
  private fun applySafeArea(webView: WebView) {
    try {
      val density = webView.resources.displayMetrics.density.takeIf { it > 0f } ?: 1f
      val insets = webView.rootWindowInsets
      val physicalTop = when {
        insets == null -> 0
        android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R -> maxOf(
          insets.getInsets(android.view.WindowInsets.Type.statusBars()).top,
          insets.getInsets(android.view.WindowInsets.Type.displayCutout()).top,
          insets.getInsets(android.view.WindowInsets.Type.mandatorySystemGestures()).top
        )
        else -> {
          @Suppress("DEPRECATION")
          val legacyTop = insets.systemWindowInsetTop
          legacyTop
        }
      }
      val cssTop = Math.ceil(physicalTop / density.toDouble()).toInt()
      webView.evaluateJavascript(
        "document.documentElement.style.setProperty('--stb-safe-top','${cssTop}px')",
        null
      )
      record("pad", "safe-area top=${physicalTop}px density=$density css=${cssTop}px")
    } catch (error: Exception) {
      record("pad", "safe-area-failed ${error.javaClass.simpleName}: ${error.message}")
    }
  }

  private class AssetSource(val size: Long, val open: (offset: Long, count: Long) -> InputStream)

  fun intercept(request: WebResourceRequest): WebResourceResponse? {
    val uri = request.url
    if (uri.path?.startsWith("/static/") != true) return null
    val path = uri.path!!
    val relativePath = path.removePrefix("/")
    if (!relativePath.startsWith("static/") || relativePath.split('/').any { it == ".." }) {
      record("pad-miss", "url=$uri reason=invalid-static-path")
      return null
    }

    // Preferred route: Play Asset Delivery resolves the exact on-disk offset,
    // so Range requests for large models can be answered without buffering.
    val pad = padSource(uri, relativePath)
    if (pad != null) return serve(uri, relativePath, pad, request.requestHeaders["Range"], "pad-hit")

    // Fallback: some Play deliveries expose the pack through AssetManager
    // instead of a resolvable path, and the QA APK built with
    // STBLOCK_ANDROID_TEST_APK=1 keeps static/ inside the base APK.
    val base = baseAssetSource(uri, relativePath)
    if (base != null) return serve(uri, relativePath, base, request.requestHeaders["Range"], "asset-hit")

    record("pad-miss", "url=$uri path=$relativePath range=${request.requestHeaders["Range"] ?: "none"}")
    return null
  }

  private fun padSource(uri: Uri, relativePath: String): AssetSource? {
    val asset = try {
      manager?.getAssetLocation(PACK_NAME, relativePath)
    } catch (error: Exception) {
      record("pad-error", "url=$uri lookup=${error.javaClass.simpleName}:${error.message}")
      null
    } ?: return null
    val target = try {
      File(asset.path()).canonicalFile
    } catch (error: Exception) {
      record("pad-error", "url=$uri path=${error.javaClass.simpleName}:${error.message}")
      return null
    }
    if (!target.isFile) {
      record("pad-error", "url=$uri reason=target-not-file target=$target")
      return null
    }
    return AssetSource(asset.size()) { offset, count ->
      boundedStream(target, asset.offset() + offset, count)
    }
  }

  private fun baseAssetSource(uri: Uri, relativePath: String): AssetSource? {
    val assets = appContext?.assets ?: return null
    val descriptor = try {
      assets.openFd(relativePath)
    } catch (_: Exception) {
      null
    }
    if (descriptor != null) {
      val length = descriptor.length
      if (length >= 0L) {
        record("asset-fd", "url=$uri path=$relativePath size=$length")
        return AssetSource(length) { offset, count ->
          boundedStream(descriptor.createInputStream(), offset, count)
        }
      }
      try {
        descriptor.close()
      } catch (_: Exception) {}
    }
    // Compressed entries cannot report an offset/length. Stream them whole and
    // ignore Range: those static files are requested once per session.
    return try {
      assets.open(relativePath, AssetManager.ACCESS_STREAMING).close()
      record("asset-stream", "url=$uri path=$relativePath size=unknown")
      AssetSource(-1L) { _, _ -> assets.open(relativePath, AssetManager.ACCESS_STREAMING) }
    } catch (error: Exception) {
      record("pad-miss", "url=$uri path=$relativePath base=${error.javaClass.simpleName}")
      null
    }
  }

  private fun serve(
    uri: Uri,
    relativePath: String,
    source: AssetSource,
    rangeHeader: String?,
    hitCategory: String
  ): WebResourceResponse? {
    return try {
      val response = rangedResponse(relativePath, source, rangeHeader)
      record("$hitCategory", "status=${response.statusCode} mime=${response.mimeType} url=$uri size=${source.size} range=${rangeHeader ?: "none"}")
      response
    } catch (error: Exception) {
      record("pad-error", "url=$uri serve=${error.javaClass.simpleName}:${error.message}")
      null
    }
  }

