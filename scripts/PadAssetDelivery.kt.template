  private fun rangedResponse(relativePath: String, source: AssetSource, rangeHeader: String?): WebResourceResponse {
    val mime = mimeTypeFor(relativePath)
    if (source.size < 0L) {
      val headers = mapOf("Cache-Control" to "public, max-age=31536000")
      return WebResourceResponse(mime, null, 200, "OK", headers, source.open(0L, -1L))
    }
    val headers = linkedMapOf(
      "Accept-Ranges" to "bytes",
      "Cache-Control" to "public, max-age=31536000",
      "Content-Length" to source.size.toString()
    )
    val length = source.size

    if (rangeHeader?.startsWith("bytes=") != true) {
      return WebResourceResponse(mime, null, 200, "OK", headers, source.open(0L, length))
    }

    val range = rangeHeader.removePrefix("bytes=").substringBefore(',').trim()
    val parts = range.split('-', limit = 2)
    if (parts.size != 2) return WebResourceResponse(mime, null, 200, "OK", headers, source.open(0L, length))
    var start = parts[0].toLongOrNull() ?: 0L
    var end = parts[1].toLongOrNull() ?: (length - 1)
    if (parts[0].isEmpty()) {
      val suffixLength = parts[1].toLongOrNull() ?: 0L
      start = (length - suffixLength).coerceAtLeast(0L)
      end = length - 1
    }
    if (start >= length || end < start) {
      return WebResourceResponse(mime, null, 416, "Range Not Satisfiable", mapOf("Content-Range" to "bytes */$length"), "".byteInputStream())
    }
    end = end.coerceAtMost(length - 1)
    val contentLength = end - start + 1
    headers["Content-Length"] = contentLength.toString()
    headers["Content-Range"] = "bytes $start-$end/$length"
    return WebResourceResponse(mime, null, 206, "Partial Content", headers, source.open(start, contentLength))
  }

  private fun mimeTypeFor(relativePath: String): String {
    val extension = relativePath.substringAfterLast('.', "").lowercase()
    return when (extension) {
      "svg" -> "image/svg+xml"
      "js", "mjs" -> "application/javascript"
      "css" -> "text/css"
      "json", "gltf" -> "application/json"
      "wasm" -> "application/wasm"
      "glb", "bin" -> "application/octet-stream"
      else -> null
    } ?: MimeTypeMap.getSingleton().getMimeTypeFromExtension(extension)
      ?: URLConnection.guessContentTypeFromName(relativePath)
      ?: "application/octet-stream"
  }

  private fun boundedStream(file: File, offset: Long, count: Long): InputStream =
    boundedStream(file.inputStream(), offset, count)

  private fun boundedStream(input: InputStream, offset: Long, count: Long): InputStream {
    var skipped = 0L
    while (skipped < offset) {
      val step = input.skip(offset - skipped)
      if (step > 0) {
        skipped += step
        continue
      }
      // Some streams (notably AutoCloseInputStream) return 0 instead of -1
      // when skip() cannot advance; read one byte so we make progress.
      if (input.read() < 0) break
      skipped += 1
    }
    val stream = input
    return object : InputStream() {
      private var remaining = count
      override fun read(): Int = if (remaining <= 0) -1 else stream.read().also { if (it >= 0) remaining-- }
      override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
        if (remaining <= 0) return -1
        val read = stream.read(buffer, offset, minOf(length.toLong(), remaining).toInt())
        if (read > 0) remaining -= read
        return read
      }
      override fun close() = stream.close()
    }
  }
