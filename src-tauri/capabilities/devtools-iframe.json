{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "devtools-iframe",
  "description": "Permite alternar devtools (F12 / Ctrl+Shift+I) desde el iframe de SketchForge en desarrollo.",
  "windows": [
    "*"
  ],
  "local": false,
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://localhost:8601",
      "http://localhost:8601/*",
      "http://localhost:5173",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5173/*"
    ]
  },
  "permissions": [
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
